{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["."],
        "excludes": ["vendor", "tests", "docker", "bin", "docs", ".github", "node_modules"]
    },
    "phpUnit": {
        "configDir": "."
    },
    "logs": {
        "text": "infection.log"
    },
    "minMsi": 90,
    "minCoveredMsi": 90,
    "mutators": {
        "@default": true
    }
}
