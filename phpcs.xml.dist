<?xml version="1.0"?>
<ruleset name="object-cache-apcu" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/squizlabs/PHP_CodeSniffer/master/phpcs.xsd">
	<description>WordPress Coding Standards for the APCu object cache drop-in. Run with `make lint` / `make fix`.</description>

	<file>object-cache.php</file>
	<file>tests</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="parallel" value="8"/>

	<!-- Lowest PHP and WordPress versions supported (WordPress 7.x requires PHP 7.4). -->
	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="5.6"/>

	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>

	<!--
	WordPress loads the drop-in by its fixed name, wp-content/object-cache.php,
	and it has to declare both core's wp_cache_* functions and WP_Object_Cache
	in that one file.
	-->
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>object-cache\.php</exclude-pattern>
		<!-- PHPUnit test files are named for what they test (test-replace.php). -->
		<exclude-pattern>/tests/</exclude-pattern>
	</rule>
	<rule ref="Universal.Files.SeparateFunctionsFromOO.Mixed">
		<exclude-pattern>object-cache\.php</exclude-pattern>
	</rule>

	<!--
	A drop-in has to define WordPress's own object cache API, so its global
	functions and class are named by core (wp_cache_*, WP_Object_Cache).
	-->
	<!--
	The test tooling is run on the command line, not in a request: it writes to
	STDERR and prints plain text, not HTML.
	-->
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>/tests/</exclude-pattern>
	</rule>
	<rule ref="WordPress.Security.EscapeOutput">
		<exclude-pattern>/tests/</exclude-pattern>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<!-- Test classes are named for what they test, and the bootstrap stubs WordPress functions by their core names. -->
		<exclude-pattern>/tests/</exclude-pattern>
		<properties>
			<property name="prefixes" type="array">
				<element value="wp_cache"/>
				<element value="wp_object_cache"/>
			</property>
		</properties>
	</rule>
</ruleset>
