# Keep Composer/GitHub dist archives to the drop-in and the files Composer
# installers skip by default (README, LICENSE, CHANGELOG, composer.json).
# koodimonni/composer-dropin-installer copies every other file in the archive into
# wp-content, so nothing else may be added here without being export-ignored.
/CONTRIBUTING.md          export-ignore
/SECURITY.md              export-ignore
/docs                     export-ignore
/bin                     export-ignore
/commitlint.config.js export-ignore
/.claude                  export-ignore
/.dockerignore            export-ignore
/.gitattributes           export-ignore
/.github                  export-ignore
/.gitignore               export-ignore
/.release-please-manifest.json export-ignore
/Makefile                 export-ignore
/composer.lock            export-ignore
/docker                   export-ignore
/docker-compose.yml       export-ignore
/infection.json5          export-ignore
/phpcs.xml.dist           export-ignore
/phpstan.neon.dist        export-ignore
/phpunit.xml.dist         export-ignore
/rector.php               export-ignore
/release-please-config.json export-ignore
/tests                    export-ignore

# Always LF, so the drop-in is byte-identical on every platform.
*.php text eol=lf
*.sh  text eol=lf
