{
    "name": "l3rady/object-cache-apcu",
    "description": "APCu backend for WordPress' Object Cache",
    "type": "wordpress-dropin",
    "keywords": [
        "wordpress",
        "object-cache",
        "apcu",
        "cache",
        "drop-in"
    ],
    "homepage": "https://github.com/l3rady/object-cache-apcu",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Scott Cariss",
            "email": "scott@cariss.dev"
        }
    ],
    "support": {
        "issues": "https://github.com/l3rady/object-cache-apcu/issues",
        "source": "https://github.com/l3rady/object-cache-apcu",
        "security": "https://github.com/l3rady/object-cache-apcu/blob/main/SECURITY.md"
    },
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "php-stubs/wordpress-stubs": "^7.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^9.6",
        "rector/rector": "^2.7",
        "squizlabs/php_codesniffer": "^3.13",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.4"
    },
    "suggest": {
        "ext-apcu": "Required at runtime for persistent caching; without it the cache lives in memory for one request only."
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "7.4.33"
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": "phpcs",
        "stan": "phpstan analyse --memory-limit=1G",
        "rector": "rector process --dry-run --no-progress-bar",
        "test": "phpunit"
    },
    "scripts-descriptions": {
        "lint": "Check the WordPress Coding Standards.",
        "stan": "Run PHPStan.",
        "rector": "Show PHP 7.4 syntax upgrades still to do.",
        "test": "Run the plain APCu tests."
    }
}
